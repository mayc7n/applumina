# Copie para .env.production no servidor. Nunca envie .env.production ao Git.
DOMAIN=app.seudominio.com
ACME_EMAIL=voce@seudominio.com

DB_NAME=lumina
DB_MIGRATION_USERNAME=lumina_owner
DB_MIGRATION_PASSWORD=GERE_UMA_SENHA_FORTE_PARA_MIGRACOES
DB_APP_USERNAME=lumina_app
DB_APP_PASSWORD=GERE_OUTRA_SENHA_FORTE_PARA_A_APLICACAO

REDIS_PASSWORD=GERE_UMA_SENHA_FORTE

RABBITMQ_USERNAME=lumina
RABBITMQ_PASSWORD=GERE_UMA_SENHA_FORTE

# Gere com: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=GERE_UM_SEGREDO_DE_PELO_MENOS_64_BYTES

# Gere uma frase distinta do JWT e guarde fora do servidor quando possível.
BACKUP_ENCRYPTION_PASSPHRASE=GERE_UMA_FRASE_FORTE_E_EXCLUSIVA

# Imagens publicadas pelo GitHub Actions. Altere se usar outro registry.
BACKEND_IMAGE=ghcr.io/mayc7n/lumina-backend:latest
